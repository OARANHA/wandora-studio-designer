# App
NODE_ENV=production
PORT=3210
PUBLIC_URL=https://designer-vigia.wandora.com.br
SESSION_DAYS=30

# Login (gere o hash com: npm run hash-password -- 'sua-senha')
STUDIO_ADMIN_EMAIL=admin@wandora.com.br
STUDIO_ADMIN_PASSWORD_HASH=scrypt:<salt-hex>:<hash-hex>
SESSION_SECRET=<minimo-32-caracteres-aleatorios>

# Jev oficial / TypeSafe
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
JEV_MODEL=
JEV_TIMEOUT_MS=20000

# NVIDIA API Catalog
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_TIMEOUT_MS=120000

# Chutes · LLM gateway + mídia opcional
CHUTES_BASE_URL=https://llm.chutes.ai/v1
CHUTES_API_KEY=
CHUTES_TIMEOUT_MS=60000
# Endpoints de chutes multimodais específicos (não confundir com o gateway LLM)
CHUTES_IMAGE_URL=
CHUTES_IMAGE_MODEL=
CHUTES_VIDEO_URL=
CHUTES_VIDEO_MODEL=
